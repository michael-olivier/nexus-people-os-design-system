      "4": { "$value": "#5390d9", "$type": "color" },
      "5": { "$value": "#4ea8de", "$type": "color" },
      "6": { "$value": "#48bfe3", "$type": "color" },
      "7": { "$value": "#56cfe1", "$type": "color" },
      "8": { "$value": "#64dfdf", "$type": "color" },
