  "cssRules": {
    "brand": {
      "display": "flex",
      "align-items": "center",
      "gap": "14px",
      "padding": "4px 4px 8px",
      "min-width": "0",
      "border-radius": "var(--nx-radius-md)",
      "color": "inherit",
      "text-decoration": "none",
      "transition": "background var(--nx-duration-fast) var(--nx-ease-standard)"
    },
    "brand-mark": {
      "display": "grid",
      "width": "46px",
      "height": "46px",
      "flex-shrink": "0",
      "place-items": "center",
      "border-radius": "12px",
      "background": "color-mix(in srgb, var(--palette-7) 14%, white)",
      "color": "var(--palette-3)",
      "padding": "9px",
      "box-sizing": "border-box"
    },
    "brand-mark--logo": {
      "padding": "0",
      "background": "transparent",
      "overflow": "hidden"
    },
    "primary-button": {
      "border": "0",
      "border-radius": "var(--nx-radius-pill)",
      "background": "var(--accent)",
      "color": "var(--white)",
      "font-weight": "var(--nx-font-weight-regular)",
      "padding": "12px 18px",
      "box-shadow": "0 10px 30px rgba(17, 24, 39, 0.04)",
      "transition": "filter var(--nx-duration-fast) var(--nx-ease-standard)"
    },
    "secondary-button": {
      "padding": "12px 18px",
      "box-shadow": "0 10px 30px rgba(17, 24, 39, 0.04)"
    },
    "prompt-grid": {
      "display": "flex",
      "flex-wrap": "wrap",
      "gap": "10px",
      "justify-content": "center",
      "max-width": "900px"
    },
    "icon-button": {
      "display": "grid",
      "width": "42px",
      "height": "42px",
      "place-items": "center",
      "border": "0",
      "border-radius": "50%",
      "color": "var(--text)",
      "transition": "background var(--nx-duration-fast) var(--nx-ease-standard),\n    color var(--nx-duration-fast) var(--nx-ease-standard),\n    opacity var(--nx-duration-fast) var(--nx-ease-standard)"
    },
    "secondary-icon": {
      "background": "var(--surface-muted)"
    },
    "send-icon": {
      "border": "0",
      "background": "var(--accent)",
      "color": "var(--white)"
    },
    "chat-composer": {
      "display": "grid",
      "gap": "10px",
      "width": "100%",
      "max-width": "940px",
      "margin": "18px 0 20px",
      "text-align": "center"
    },
    "input-row": {
      "display": "grid",
      "grid-template-columns": "auto 1fr auto auto",
      "align-items": "center",
      "gap": "10px",
      "padding": "8px",
      "border": "1px solid var(--line)",
      "border-radius": "100px",
      "background": "var(--surface)",
      "box-shadow": "0 10px 30px rgba(17, 24, 39, 0.04)"
    },
    "input-row-compact": {
      "grid-template-columns": "1fr auto auto"
    },
    "panel": {
      "display": "grid",
      "gap": "18px",
      "min-height": "260px",
      "padding": "22px",
      "border": "1px solid var(--line)",
      "border-radius": "var(--nx-radius-lg)",
      "background": "var(--surface)",
      "box-shadow": "0 14px 44px rgba(17, 24, 39, 0.04)"
    },
    "panel-header": {
      "display": "flex",
      "align-items": "flex-start",
      "justify-content": "space-between",
      "gap": "16px"
    },
    "hero-card": {
      "display": "grid",
      "gap": "22px",
      "justify-items": "center",
      "margin-bottom": "24px",
      "padding": "clamp(20px, 4vw, 42px) 0 28px",
      "border": "0",
      "border-radius": "0",
      "background": "transparent",
      "box-shadow": "none"
    },
    "hero-copy": {
      "width": "min(100%, 760px)",
      "max-width": "760px",
      "text-align": "center"
    },
    "status-pill": {
      "display": "inline-flex",
      "align-items": "center",
      "gap": "6px",
      "justify-self": "end",
      "box-sizing": "border-box",
      "height": "32px",
      "padding": "0 10px 0 8px",
      "border-radius": "var(--nx-radius-pill)",
      "font-size": "0.68rem",
      "font-weight": "600",
      "letter-spacing": "0.06em",
      "text-transform": "uppercase",
      "white-space": "nowrap"
    },
    "status-pill-icon": {
      "display": "grid",
      "flex-shrink": "0",
      "place-items": "center",
      "color": "inherit"
    },
    "status-pill-overdue": {
      "background": "#feecef",
      "color": "#e11d48"
    },
    "status-pill-pending": {
      "background": "#fff7ed",
      "color": "#ea580c"
    },
    "status-pill-progress": {
      "background": "#ecfdf9",
      "color": "#0d9488"
    },
    "status-pill-enrolled": {
      "background": "var(--white)",
      "color": "var(--text)",
      "border": "1px solid color-mix(in srgb, var(--text) 12%, var(--line))"
    },
    "agent-icon": {
      "display": "grid",
      "width": "28px",
      "height": "28px",
      "flex-shrink": "0",
      "place-items": "center",
      "border-radius": "var(--nx-radius-sm)"
    },
    "agent-icon-career": {
      "background": "color-mix(in srgb, var(--palette-1) 12%, white)",
      "color": "var(--palette-1)"
    },
    "agent-icon-feedback": {
      "background": "color-mix(in srgb, var(--palette-2) 12%, white)",
      "color": "var(--palette-2)"
    },
    "agent-icon-learning": {
      "background": "color-mix(in srgb, var(--palette-3) 12%, white)",
      "color": "var(--palette-3)"
    },
    "agent-icon-travel": {
      "background": "color-mix(in srgb, var(--palette-6) 14%, white)",
      "color": "var(--palette-4)"
    },
    "agent-icon-meeting": {
      "background": "color-mix(in srgb, var(--palette-4) 12%, white)",
      "color": "var(--palette-4)"
    },
    "agent-page-title": {
      "display": "inline-flex",
      "align-items": "center",
      "justify-content": "center",
      "gap": "10px",
      "margin-bottom": "6px"
    },
    "agent-icon-lg": {
      "width": "34px",
      "height": "34px",
      "border-radius": "10px"
    }
